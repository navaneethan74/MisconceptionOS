# MisconceptionOS — Environment Configuration Template
# Copy this file to .env for local configuration.
# Never commit real API keys or secrets to version control.

# Optional: Google Gemini API Key for enhanced dynamic pedagogical evaluation
# If left empty, MisconceptionOS uses its built-in client-side semantic diagnostic engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Local Development Server Port (default: 8080)
PORT=8080
